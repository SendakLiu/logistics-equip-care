      const totalExp = filteredStats.reduce((acc, s) => acc + s.exp, 0);
      const totalAct = filteredStats.reduce((acc, s) => acc + s.act, 0);
      const totalPrev = filteredStats.reduce((acc, s) => acc + s.prevAct, 0);
      const overallRate = totalExp > 0 ? (totalAct / totalExp) * 100 : 0;
      const momPct = totalPrev > 0 ? ((totalAct - totalPrev) / totalPrev) * 100 : 0;

      document.getElementById('kpi1MainRate').textContent = overallRate.toFixed(1) + '%';
