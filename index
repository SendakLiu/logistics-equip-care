<!DOCTYPE html>
<html lang="zh-Hant" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>物流設備維修保養分析預測</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Inter"', '"Noto Sans TC"', '-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'sans-serif'],
            mono: ['"JetBrains Mono"', '"SFMono-Regular"', 'Consolas', 'monospace']
          },
          boxShadow: {
            card: '0 4px 20px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -1px rgba(15, 23, 42, 0.04)',
            'card-dark': '0 4px 24px -2px rgba(0, 0, 0, 0.45)'
          }
        }
      }
    };
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;600;700&display=swap');
    body {
      font-family: 'Inter', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.45);
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(100, 116, 139, 0.7);
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .status-pulse {
      animation: pulse-ring 2s infinite;
    }
    .sort-header {
      cursor: pointer;
      user-select: none;
      transition: color 0.15s ease;
    }
    .sort-header:hover {
      color: #2563eb;
    }
    .dark .sort-header:hover {
      color: #60a5fa;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen flex flex-col">

  <!-- 1. 頂部導航列 (Header) -->
  <header class="sticky top-0 z-40 backdrop-blur-md bg-white/95 dark:bg-slate-900/95 border-b border-slate-200/80 dark:border-slate-800 shadow-sm transition-colors">
    <div class="max-w-[1640px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-3">
        <!-- 左側：系統標誌與名稱 -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">物流設備維修保養分析預測</h1>
                <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/70 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">1005-1011 自動檢查總表 · 保養時程對照版</span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                資料來源：<span class="font-medium text-slate-700 dark:text-slate-300">1005-1011自動檢查計畫表(回覆總表).xlsx</span> ＆ <span class="font-medium text-slate-700 dark:text-slate-300">forklift_detailed_maintenance_schedule.xlsx</span>
              </p>
            </div>
          </div>

          <!-- 手機版主題切換 -->
          <button id="themeToggleMobile" onclick="toggleTheme()" class="xl:hidden p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </button>
        </div>

        <!-- 右側：狀態燈、即時時間、返回戰情儀表板、多選篩選物流別、手動重新整理、主題切換 -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
          <!-- 資料更新狀態燈 -->
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50/90 dark:bg-emerald-950/60 border border-emerald-200/80 dark:border-emerald-800/60 text-emerald-700 dark:text-emerald-300 text-xs font-semibold">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 status-pulse"></span>
            <span id="syncStatusText">即時監控連線中</span>
          </div>

          <!-- 即時系統時間 (秒數動態跳動) -->
          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100/90 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700 text-xs font-medium text-slate-600 dark:text-slate-300">
            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span id="liveClock" class="font-mono font-semibold tracking-tight text-slate-800 dark:text-slate-100">2026-11-09 06:15:00</span>
          </div>

          <!-- 頂部導航列：返回戰情儀表板按鈕 -->
          <button id="headerBackBtn" type="button" onclick="returnToWarRoom()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold bg-slate-800 hover:bg-slate-700 text-white dark:bg-indigo-600 dark:hover:bg-indigo-500 shadow-sm transition cursor-pointer" title="返回戰情儀表板主畫面並重設檢視狀態">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span>返回戰情儀表板</span>
          </button>

          <!-- 篩選物流別 (改為可多選下拉選單) -->
          <div class="relative" id="deptMultiSelectContainer">
            <button type="button" id="deptMultiSelectBtn" onclick="toggleDeptDropdown(event)" class="inline-flex items-center justify-between gap-2 bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-100 shadow-sm transition cursor-pointer min-w-[200px]">
              <div class="flex items-center gap-1.5 truncate">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">物流別(可多選)：</span>
                <span id="deptMultiSelectLabel" class="text-blue-600 dark:text-blue-400 font-bold truncate max-w-[160px]">全部物流別 (10)</span>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- 多選下拉面板 -->
            <div id="deptMultiSelectMenu" class="hidden absolute right-0 sm:left-0 mt-1.5 w-72 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xl z-50 p-3">
              <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-200 dark:border-slate-700 text-xs">
                <span class="font-bold text-slate-700 dark:text-slate-200">勾選物流別（支援多選）</span>
                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="selectAllDepts()" class="px-2 py-0.5 rounded bg-blue-50 hover:bg-blue-100 text-blue-600 dark:bg-blue-950 dark:text-blue-300 font-semibold cursor-pointer">全選(All)</button>
                  <button type="button" onclick="clearDeptSelection()" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300 font-semibold cursor-pointer">重設</button>
                </div>
              </div>
              <div id="deptCheckboxList" class="max-h-72 overflow-y-auto custom-scroll space-y-1 pr-1">
                <!-- Populated dynamically via JS -->
              </div>
            </div>
          </div>

          <!-- 手動重新整理按鈕 -->
          <button id="refreshBtn" onclick="manualRefresh()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-blue-500/20 transition cursor-pointer">
            <svg id="refreshIcon" class="w-4 h-4 transition-transform duration-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>手動重新整理</span>
          </button>

          <!-- 深淺主題切換按鈕 -->
          <button id="themeToggleBtn" onclick="toggleTheme()" class="hidden xl:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold transition cursor-pointer" title="切換淺色 / 深色戰情室主題">
            <span id="themeIconContainer">
              <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
            </span>
            <span id="themeBtnLabel">深色戰情室</span>
          </button>
        </div>
      </div>

      <!-- 快速部門多選膠囊列 -->
      <div class="flex items-center gap-1.5 overflow-x-auto custom-scroll pt-2.5 pb-1 mt-2 border-t border-slate-100 dark:border-slate-800/80" id="deptPills">
      </div>
    </div>
  </header>

  <!-- 主內容區 -->
  <main class="flex-1 max-w-[1640px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-5 space-y-6">

    <!-- 2. 核心 KPI 數據卡片 (3張頂部指標卡，附帶環比升降 % 與小圖示) -->
    <section class="grid grid-cols-1 xl:grid-cols-3 gap-5">

      <!-- 第一張數據卡：以物流別為單位分析各部門檢查率 -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200/90 dark:border-slate-700/80 shadow-card dark:shadow-card-dark flex flex-col overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-700/60">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-blue-50 text-blue-700 dark:bg-blue-950/80 dark:text-blue-300">KPI 01</span>
                <h2 class="text-sm font-bold text-slate-500 dark:text-slate-400">各部門設備自動檢查率分析</h2>
              </div>
              <div class="mt-2.5 flex items-baseline gap-3 flex-wrap">
                <span id="kpi1MainRate" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">89.9%</span>
                <span id="kpi1MomBadge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
                  ▲ +0.9% 週環比
                </span>
              </div>
              <p id="kpi1SubDesc" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
                日檢實檢 <strong class="text-slate-700 dark:text-slate-200">393</strong> / 應檢 <strong class="text-slate-700 dark:text-slate-200">437</strong> 筆
              </p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/80 border border-blue-100 dark:border-blue-800/60 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>

          <!-- 口徑切換器 -->
          <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-100 dark:border-slate-700/50">
            <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-400">統計口徑：</span>
            <div class="inline-flex rounded-lg bg-slate-100 dark:bg-slate-900 p-0.5 text-[11px] font-semibold">
              <button onclick="setRateMode('daily')" id="rateModeDaily" class="px-2.5 py-1 rounded-md bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-300 shadow-sm transition">當週日檢率 (A04-A07)</button>
              <button onclick="setRateMode('sheet')" id="rateModeSheet" class="px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 transition">檢查率頁籤全表</button>
              <button onclick="setRateMode('combined')" id="rateModeCombined" class="px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 transition">綜合完成率 (含9月月檢)</button>
            </div>
          </div>
        </div>

        <!-- 部門檢查率明細列表 (第一張數據卡內嵌) -->
        <div class="flex-1 overflow-y-auto max-h-[340px] custom-scroll divide-y divide-slate-100 dark:divide-slate-700/50 px-5 py-2" id="kpi1DeptList">
        </div>
        <div class="px-5 py-2.5 bg-slate-50/80 dark:bg-slate-800/60 border-t border-slate-100 dark:border-slate-700/60 text-[11px] text-slate-500 dark:text-slate-400 flex items-center justify-between">
          <span>點擊任一物流別可切換多選篩選狀態</span>
          <a href="#sectionRateDetail" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">查看 34 項設備檢查率明細 ↓</a>
        </div>
      </div>

      <!-- 第二張數據卡：A05、A06、A08、A09 前7天出現異常 -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200/90 dark:border-slate-700/80 shadow-card dark:shadow-card-dark flex flex-col overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-700/60">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-50 text-amber-700 dark:bg-amber-950/80 dark:text-amber-300">KPI 02</span>
                <h2 class="text-sm font-bold text-slate-500 dark:text-slate-400">堆高機與板車前 7 天異常監控</h2>
              </div>
              <div class="mt-2.5 flex items-baseline gap-3 flex-wrap">
                <span id="kpi2MainCount" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">34 <small class="text-base font-bold text-slate-500">筆</small></span>
                <span id="kpi2MomBadge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200/60 dark:border-rose-800/60">
                  ▲ +36.0% 較前7日
                </span>
              </div>
              <p id="kpi2SubDesc" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
                涵蓋 A05、A06、A08、A09（共 <strong id="kpi2EquipCount" class="text-slate-700 dark:text-slate-200">9</strong> 台設備回報異常）
              </p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/80 border border-amber-100 dark:border-amber-800/60 flex items-center justify-center text-amber-600 dark:text-amber-400 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
          </div>

          <!-- 四大機型異常筆數統計小徽章 -->
          <div class="grid grid-cols-4 gap-2 mt-3" id="kpi2TypeBadges">
          </div>

          <!-- 異常篩選切換器 -->
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 pt-2.5 border-t border-slate-100 dark:border-slate-700/50">
            <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-400">異常範圍：</span>
            <div class="inline-flex rounded-lg bg-slate-100 dark:bg-slate-900 p-0.5 text-[11px] font-semibold">
              <button onclick="setAbnMode('func7d')" id="abnModeFunc7d" class="px-2 py-1 rounded-md bg-white dark:bg-slate-700 text-amber-600 dark:text-amber-300 shadow-sm transition">前7天功能異常</button>
              <button onclick="setAbnMode('all7d')" id="abnModeAll7d" class="px-2 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 transition">前7天全數(含清潔/免加水)</button>
              <button onclick="setAbnMode('all30d')" id="abnModeAll30d" class="px-2 py-1 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 transition">近30天(含A08/A09月檢)</button>
            </div>
          </div>
        </div>

        <!-- 異常設備摘要清單 (第二張數據卡內嵌) -->
        <div class="flex-1 overflow-y-auto max-h-[300px] custom-scroll divide-y divide-slate-100 dark:divide-slate-700/50 px-5 py-2" id="kpi2AbnList">
        </div>
        <div class="px-5 py-2.5 bg-slate-50/80 dark:bg-slate-800/60 border-t border-slate-100 dark:border-slate-700/60 text-[11px] text-slate-500 dark:text-slate-400 flex items-center justify-between">
          <span>A08、A09 為月檢設備，切換「近30天」可檢視月底異常</span>
          <a href="#sectionAbnTable" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">查看完整異常明細 ↓</a>
        </div>
      </div>

      <!-- 第三張數據卡：A05、A06、A08、A09 里程與保養時程對照剩餘天數預測 -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200/90 dark:border-slate-700/80 shadow-card dark:shadow-card-dark flex flex-col overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-700/60">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/80 dark:text-indigo-300">KPI 03</span>
