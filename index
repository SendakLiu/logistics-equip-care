    // 10. 渲染各機型保養時間與里程標準對照表 (forklift_detailed_maintenance_schedule.xlsx)
    function setSchedFilter(stype) {
      schedTypeFilter = stype;
      document.querySelectorAll('#schedTypeFilterBtns button').forEach(btn => {
        if (btn.dataset.stype === stype) {
          btn.className = 'px-3 py-1 rounded-lg bg-white dark:bg-slate-700 text-indigo-600 dark:text-indigo-300 shadow-sm transition cursor-pointer';
        } else {
          btn.className = 'px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 transition cursor-pointer';
        }
      });
      renderSchedTable();
    }

    function renderSchedTable() {
      const kmFilter = document.getElementById('schedKmSelect').value;
      const activeEquips = getProcessedEquipment().filter(e => e.has_real_mile);

      const rules = RAW_DATA.maint_schedule_rules.filter(r => {
        if (schedTypeFilter !== 'ALL' && r.code !== schedTypeFilter) return false;
        if (kmFilter !== 'ALL') {
          const target = parseInt(kmFilter, 10);
          if (target === 500 && r.primary_km > 500) return false;
          if (target === 1250 && (r.primary_km < 750 || r.primary_km > 1250)) return false;
          if (target === 2500 && (r.primary_km < 1500 || r.primary_km > 2500)) return false;
          if (target === 5000 && (r.primary_km < 3000 || r.primary_km > 5000)) return false;
          if (target === 10000 && r.primary_km < 10000) return false;
        }
        return true;
      });

      document.getElementById('schedRuleCountBadge').textContent = `${rules.length} 項標準保養規範`;

      const tbody = document.getElementById('schedTableBody');
      tbody.innerHTML = rules.map(r => {
        // Count how many active equipments of this code are within 30 days of a multiple of r.primary_km
        const dueEquips = activeEquips.filter(eq => {
          if (eq.code !== r.code) return false;
          const remKm = r.primary_km - (eq.active_curr_mile % r.primary_km);
          const remDays = eq.active_daily_km > 0 ? remKm / eq.active_daily_km : 999;
          return remDays <= 30;
        });

        const codeBadge = r.code === 'A08'
          ? 'bg-amber-50 text-amber-700 dark:bg-amber-950/80 dark:text-amber-300 border-amber-200'
          : (r.code === 'A05'
            ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/80 dark:text-blue-300 border-blue-200'
            : (r.code === 'A09'
              ? 'bg-purple-50 text-purple-700 dark:bg-purple-950/80 dark:text-purple-300 border-purple-200'
              : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300 border-emerald-200'));

        return `
          <tr class="hover:bg-slate-50/90 dark:hover:bg-slate-700/30 transition">
            <td class="py-3 px-4 whitespace-nowrap">
              <span class="px-2 py-0.5 rounded-md text-xs font-bold border ${codeBadge}">${r.code} ${r.equip_type}</span>
            </td>
            <td class="py-3 px-4 font-bold text-slate-800 dark:text-slate-100 whitespace-nowrap">${r.category}</td>
            <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">${r.item}</td>
            <td class="py-3 px-4 font-mono font-bold text-indigo-600 dark:text-indigo-400 whitespace-nowrap">${r.hours_str}</td>
            <td class="py-3 px-4 font-mono font-bold text-blue-600 dark:text-blue-400 whitespace-nowrap">${r.km_str}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-300">${r.note}</td>
            <td class="py-3 px-4 text-center whitespace-nowrap">
              ${dueEquips.length > 0
                ? `<span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-rose-50 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800" title="${dueEquips.map(e => e.dept + ' #' + e.car).join('、')}">${dueEquips.length} 台即將到期</span>`
                : `<span class="text-xs text-slate-400">0 台</span>`
              }
            </td>
          </tr>
        `;
      }).join('');
    }

    // 11. 單機保養診斷與時程對照彈窗 (Modal)
    function openEquipModal(dept, code, car) {
      const list = getProcessedEquipment();
      const eq = list.find(x => x.dept === dept && x.code === code && x.car === car)
        || RAW_DATA.equipment.find(x => x.dept === dept && x.code === code && x.car === car);
      if (!eq) return;

      document.getElementById('modalEquipDept').textContent = eq.dept;
      document.getElementById('modalEquipTitle').textContent = `${eq.type_name} 車號 #${eq.car}`;
      document.getElementById('modalEquipSub').textContent =
        `目前累積里程：${(eq.active_curr_mile ?? eq.curr_mile).toLocaleString()} km ｜ 推估運轉時數：${eq.est_hours.toLocaleString()} 小時 (換算基準 1小時 ≈ ${eq.km_per_hr} km) ｜ 最近點檢日：${eq.last_dt}`;

      const rules = RAW_DATA.maint_schedule_rules.filter(r => r.code === eq.code);
      const stages = eq.active_stages || eq.upcoming_stages || [];

      const stagesHtml = stages.map(st => {
        const urgent = st.rem_days <= 14;
        const warn = st.rem_days <= 30;
        const cls = urgent
          ? 'border-rose-300 bg-rose-50/60 dark:border-rose-800 dark:bg-rose-950/30'
          : (warn ? 'border-amber-300 bg-amber-50/60 dark:border-amber-800 dark:bg-amber-950/30' : 'border-slate-200 bg-slate-50/60 dark:border-slate-700 dark:bg-slate-800/60');
        return `
          <div class="p-3 rounded-xl border ${cls} flex items-center justify-between gap-3">
            <div>
              <div class="font-bold text-slate-900 dark:text-white">${st.label}</div>
              <div class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">${st.summary}</div>
              <div class="text-[11px] text-slate-400 mt-1">下次目標點：<strong class="font-mono text-slate-700 dark:text-slate-200">${st.next_km.toLocaleString()} km (${st.next_hrs.toLocaleString()} 小時)</strong></div>
            </div>
            <div class="text-right shrink-0">
              <div class="font-mono font-extrabold text-sm ${urgent ? 'text-rose-600 dark:text-rose-400' : 'text-indigo-600 dark:text-indigo-400'}">剩餘 ${st.rem_km.toLocaleString()} km</div>
              <div class="text-xs font-mono font-semibold text-slate-600 dark:text-slate-300">約 ${st.rem_days} 天</div>
            </div>
          </div>
        `;
      }).join('');

      const rulesHtml = rules.map(r => {
        const remKm = r.primary_km - ((eq.active_curr_mile ?? eq.curr_mile) % r.primary_km);
        const daily = eq.active_daily_km || eq.est_daily_km || 20;
        const remDays = +(remKm / daily).toFixed(1);
        return `
          <tr class="border-b border-slate-100 dark:border-slate-700/60">
            <td class="py-2 px-2.5 font-bold text-slate-800 dark:text-slate-200 whitespace-nowrap">${r.category}</td>
            <td class="py-2 px-2.5 text-slate-700 dark:text-slate-200">${r.item}</td>
            <td class="py-2 px-2.5 font-mono text-indigo-600 dark:text-indigo-400 whitespace-nowrap">${r.hours_str}</td>
            <td class="py-2 px-2.5 font-mono text-blue-600 dark:text-blue-400 whitespace-nowrap">${r.km_str}</td>
            <td class="py-2 px-2.5 font-mono font-bold text-right whitespace-nowrap ${remDays <= 14 ? 'text-rose-600 dark:text-rose-400' : 'text-slate-700 dark:text-slate-300'}">差 ${remKm.toLocaleString()}km (${remDays}天)</td>
          </tr>
        `;
      }).join('');

      document.getElementById('modalEquipBody').innerHTML = `
        <div>
          <h5 class="font-bold text-slate-800 dark:text-slate-100 mb-2">一、各階層保養里程與倒數天數預估</h5>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">${stagesHtml}</div>
        </div>
        <div>
          <h5 class="font-bold text-slate-800 dark:text-slate-100 mb-2">二、該機型完整保養規範對照 (${eq.sched_type})</h5>
          <div class="overflow-x-auto border border-slate-200 dark:border-slate-700 rounded-xl">
            <table class="w-full text-left border-collapse text-xs">
              <thead class="bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-slate-300">
                <tr>
                  <th class="py-2 px-2.5">保養類別</th>
                  <th class="py-2 px-2.5">詳細保養項目</th>
                  <th class="py-2 px-2.5">建議時數</th>
                  <th class="py-2 px-2.5">對應里程</th>
                  <th class="py-2 px-2.5 text-right">本車距離下次保養</th>
                </tr>
              </thead>
              <tbody>${rulesHtml}</tbody>
            </table>
          </div>
        </div>
      `;

      document.getElementById('equipDetailModal').classList.remove('hidden');
    }

    function closeEquipModal(e) {
      if (e && e.target && e.target.id !== 'equipDetailModal') return;
      document.getElementById('equipDetailModal').classList.add('hidden');
    }

    // 12. 渲染異常明細表 (支援排序與搜尋)
    function sortAbnTable(key) {
      if (abnSort.key === key) {
        abnSort.asc = !abnSort.asc;
      } else {
        abnSort.key = key;
        abnSort.asc = true;
      }
      ['dt', 'dept', 'code', 'car', 'user'].forEach(k => {
        const el = document.getElementById('sortAbn_' + k);
        if (el) el.textContent = k === abnSort.key ? (abnSort.asc ? '▲' : '▼') : '';
      });
      renderAbnTable();
    }

    function renderAbnTable() {
      const q = (document.getElementById('abnSearchInput').value || '').trim().toLowerCase();
      let list = getFilteredAnomalies().filter(a => {
        if (!q) return true;
        const hay = `${a.dt} ${a.dept} ${a.code} ${a.car} ${a.user} ${a.issues.join(' ')}`.toLowerCase();
        return hay.includes(q);
      });

      list.sort((a, b) => {
        const va = a[abnSort.key] || '', vb = b[abnSort.key] || '';
        return abnSort.asc
          ? String(va).localeCompare(String(vb), 'zh-Hant', { numeric: true })
          : String(vb).localeCompare(String(va), 'zh-Hant', { numeric: true });
      });

      document.getElementById('abnTableCountBadge').textContent = `${list.length} 筆異常`;
      const tbody = document.getElementById('abnTableBody');
      if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="py-10 text-center text-slate-400">無符合篩選條件之異常紀錄</td></tr>`;
        return;
      }

      tbody.innerHTML = list.map(a => {
        const badgeCls = a.cat === 'func'
          ? 'bg-rose-50 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800'
          : (a.cat === 'lithium' ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/80 dark:text-blue-300' : 'bg-amber-50 text-amber-700 dark:bg-amber-950/80 dark:text-amber-300');
        const catLabel = a.cat === 'func' ? '功能/結構故障' : (a.cat === 'lithium' ? '鋰電池免加水' : '外觀未清潔');
        const mileDisplay = a.mile && !isNaN(Number(a.mile)) ? `${Number(a.mile).toLocaleString()} km` : (a.mile || '—');
        return `
          <tr class="hover:bg-slate-50/90 dark:hover:bg-slate-700/30 transition">
            <td class="py-3 px-4 font-mono text-slate-600 dark:text-slate-300 whitespace-nowrap">${a.dt}</td>
            <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-100 whitespace-nowrap">${a.dept}</td>
            <td class="py-3 px-4 font-semibold text-slate-700 dark:text-slate-200 whitespace-nowrap">${a.sname}</td>
            <td class="py-3 px-4 font-mono font-bold text-blue-600 dark:text-blue-400 whitespace-nowrap">#${a.car}</td>
            <td class="py-3 px-4 font-mono text-right text-slate-700 dark:text-slate-300 whitespace-nowrap">${mileDisplay}</td>
            <td class="py-3 px-4 text-slate-700 dark:text-slate-200 whitespace-nowrap">${a.user || '—'}</td>
            <td class="py-3 px-4 text-slate-700 dark:text-slate-200">${a.issues.join(' ； ')}</td>
            <td class="py-3 px-4 text-center whitespace-nowrap">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold ${badgeCls}">${catLabel}</span>
            </td>
          </tr>
        `;
      }).join('');
    }

    // 13. 渲染 34 項設備自動檢查率矩陣表
    function setCycleFilter(cyc) {
      cycleFilter = cyc;
      document.querySelectorAll('#cycleFilterBtns button').forEach(btn => {
        if (btn.dataset.cyc === cyc) {
          btn.className = 'px-3 py-1 rounded-lg bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-300 shadow-sm transition cursor-pointer';
        } else {
          btn.className = 'px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 transition cursor-pointer';
        }
      });
      renderMatrixTable();
    }

    function renderMatrixTable() {
      const thead = document.getElementById('matrixTableHead');
      const isAll = selectedDepts.length === 0;
      thead.innerHTML = `
        <tr>
          <th class="py-3 px-4">代號</th>
          <th class="py-3 px-4">檢查種類名稱</th>
          <th class="py-3 px-3 text-center">週期</th>
          ${RAW_DATA.depts.map(d => {
            const highlight = !isAll && selectedDepts.includes(d);
            return `<th onclick="toggleDeptQuick('${d}')" class="py-3 px-3 text-center cursor-pointer transition ${highlight ? 'bg-blue-50/90 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300 underline' : 'hover:text-blue-600'}">${d}</th>`;
          }).join('')}
        </tr>
      `;

      const items = RAW_DATA.inspection_items.filter(it => {
        if (cycleFilter === 'ALL') return true;
        if (cycleFilter === '季') return it.cycle === '季' || it.cycle === '-';
        return it.cycle === cycleFilter;
      });

      const tbody = document.getElementById('matrixTableBody');
      tbody.innerHTML = items.map(it => {
        const cycBadge = it.cycle === '日'
          ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/80 dark:text-blue-300'
          : (it.cycle === '月' ? 'bg-purple-50 text-purple-700 dark:bg-purple-950/80 dark:text-purple-300' : 'bg-amber-50 text-amber-700 dark:bg-amber-950/80 dark:text-amber-300');

        const cells = RAW_DATA.depts.map(d => {
          const obj = it.by_dept[d];
          const dim = !isAll && !selectedDepts.includes(d) ? 'opacity-40' : '';
          if (!obj || (obj.forms === 0 && obj.exp === 0)) {
            return `<td class="py-2.5 px-2 text-center text-slate-300 dark:text-slate-600 ${dim}">—</td>`;
          }
          const act = rateMode === 'combined' && it.cycle !== '日' ? Math.min(obj.exp, obj.act_sep) : obj.act_sheet;
          const r = obj.exp > 0 ? Math.round((act / obj.exp) * 100) : 0;
          const colorCls = r >= 100
            ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300 font-bold'
            : (r > 0 ? 'bg-amber-50 text-amber-700 dark:bg-amber-950/70 dark:text-amber-300 font-bold' : 'bg-slate-100 text-slate-500 dark:bg-slate-700/50 dark:text-slate-400');

          return `
            <td class="py-2.5 px-2 text-center ${dim}">
              <div class="inline-flex flex-col items-center px-2 py-0.5 rounded-lg ${colorCls}">
                <span class="font-mono text-xs">${r}%</span>
                <span class="text-[10px] opacity-75">${act}/${obj.exp} (表:${obj.forms})</span>
              </div>
            </td>
          `;
        }).join('');

        return `
          <tr class="hover:bg-slate-50/90 dark:hover:bg-slate-700/30 transition">
            <td class="py-2.5 px-4 font-mono font-bold text-slate-700 dark:text-slate-200">${it.code}</td>
            <td class="py-2.5 px-4 font-semibold text-slate-800 dark:text-slate-100">${it.title}</td>
            <td class="py-2.5 px-3 text-center"><span class="px-2 py-0.5 rounded text-xs font-bold ${cycBadge}">${it.cycle}</span></td>
            ${cells}
          </tr>
        `;
      }).join('');
    }

    function renderAll() {
      renderDeptSelectors();
      renderKpi1();
      renderKpi2();
      renderKpi3();
      renderCharts();
      renderMaintTable();
      renderSchedTable();
      renderAbnTable();
      renderMatrixTable();
    }

    // 初始化
    renderAll();
  </script>
</body>
</html>
