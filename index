    // 7. 第三張數據卡與保養時程對照預測計算
    function getProcessedEquipment() {
      return RAW_DATA.equipment.filter(eq => {
        if (!isDeptMatch(eq.dept)) return false;
        if (mileMode !== 'allEquip' && !eq.has_real_mile) return false;
        return true;
      }).map(eq => {
        const dailyKm = customDailyKm !== null && customDailyKm > 0 ? customDailyKm : eq.est_daily_km;
        const currMile = eq.curr_mile;
        const usedInCycle = currMile % 5000;
        const remKm5000 = 5000 - usedInCycle;
        const nextTargetKm5000 = (Math.floor(currMile / 5000) + 1) * 5000;
        const remDays5000 = dailyKm > 0 ? +(remKm5000 / dailyKm).toFixed(1) : 999;

        // Recalculate stage tiers dynamically when customDailyKm changes
        const stages = eq.upcoming_stages.map(st => ({
          ...st,
          rem_days: dailyKm > 0 ? +(st.rem_km / dailyKm).toFixed(1) : 999
        })).sort((a, b) => a.rem_km - b.rem_km || b.interval_km - a.interval_km);
        const nearestStage = stages[0];

        return {
          ...eq,
          active_curr_mile: currMile,
          active_next_target_km: nextTargetKm5000,
          active_rem_km: remKm5000,
          active_daily_km: dailyKm,
          active_daily_hrs: +(dailyKm / eq.km_per_hr).toFixed(1),
          active_rem_days: remDays5000,
          active_nearest_stage: nearestStage,
          active_stages: stages,
          stage_rem_days: nearestStage.rem_days
        };
      });
    }

