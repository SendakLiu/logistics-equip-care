    function sortMaintTable(key) {
      if (maintSort.key === key) {
        maintSort.asc = !maintSort.asc;
      } else {
        maintSort.key = key;
        maintSort.asc = true;
      }
      ['dept', 'code', 'car', 'curr_mile', 'next_target_km', 'rem_km', 'est_daily_km', 'rem_days', 'stage_rem_days', 'last_dt'].forEach(k => {
        const el = document.getElementById('sortIcon_' + k);
        if (el) el.textContent = k === maintSort.key ? (maintSort.asc ? '▲' : '▼') : '';
      });
      renderMaintTable();
    }

    function renderMaintTable() {
      const q = (document.getElementById('maintSearchInput').value || '').trim().toLowerCase();
      let list = getProcessedEquipment().filter(eq => {
        if (maintTypeFilter !== 'ALL' && eq.code !== maintTypeFilter) return false;
        if (q) {
          const hay = `${eq.dept} ${eq.code} ${eq.type_name} ${eq.car} ${eq.status_tag} ${eq.milestone_5000_label} ${eq.milestone_5000_summary} ${eq.active_nearest_stage.label} ${eq.active_nearest_stage.summary}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      const keyMap = {
        curr_mile: 'active_curr_mile',
        next_target_km: 'active_next_target_km',
        rem_km: 'active_rem_km',
        est_daily_km: 'active_daily_km',
        rem_days: 'active_rem_days',
        stage_rem_days: 'stage_rem_days'
      };
      const sortKey = keyMap[maintSort.key] || maintSort.key;

      list.sort((a, b) => {
        let va = a[sortKey], vb = b[sortKey];
        if (typeof va === 'number' && typeof vb === 'number') {
          return maintSort.asc ? va - vb : vb - va;
        }
        return maintSort.asc
          ? String(va).localeCompare(String(vb), 'zh-Hant', { numeric: true })
          : String(vb).localeCompare(String(va), 'zh-Hant', { numeric: true });
      });

      document.getElementById('maintTableCountBadge').textContent = `${list.length} 台設備`;

      const tbody = document.getElementById('maintTableBody');
      if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="12" class="py-10 text-center text-slate-400">無符合篩選條件之設備</td></tr>`;
