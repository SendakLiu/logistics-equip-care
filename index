            : (isWarn ? 'bg-amber-50 text-amber-700 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200 dark:border-amber-800' : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300'));

        const st = eq.active_nearest_stage;
        const stageUrgent = st.rem_days <= 14;
        const stageBadge = !eq.has_real_mile
          ? 'bg-slate-100 text-slate-400 dark:bg-slate-700'
          : (stageUrgent ? 'bg-rose-50 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800' : 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/80 dark:text-indigo-300');

        const statusBadge = eq.abn_7d_cnt > 0
          ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300">近7日異常(${eq.abn_7d_cnt})</span>`
          : `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 dark:bg-slate-700/70 dark:text-slate-300">${eq.status_tag}</span>`;

        return `
          <tr onclick="openEquipModal('${eq.dept}', '${eq.code}', '${eq.car}')" class="hover:bg-blue-50/50 dark:hover:bg-slate-700/40 transition cursor-pointer">
