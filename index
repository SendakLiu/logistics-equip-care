    // 5. 計算各部門檢查率指標
    function computeDeptStats(deptName) {
      let forms = 0, exp = 0, act = 0, prevAct = 0;
      RAW_DATA.inspection_items.forEach(item => {
        const dObj = item.by_dept[deptName];
        if (!dObj) return;
        if (rateMode === 'daily') {
          if (item.cycle === '日') {
            forms += dObj.forms;
            exp += dObj.exp;
            act += dObj.act_sheet;
            prevAct += dObj.act_prev;
          }
        } else if (rateMode === 'sheet') {
          forms += dObj.forms;
          exp += dObj.exp;
          act += dObj.act_sheet;
          prevAct += dObj.act_prev;
        } else {
          forms += dObj.forms;
          exp += dObj.exp;
          if (item.cycle === '日') {
            act += dObj.act_sheet;
            prevAct += dObj.act_prev;
          } else {
            act += Math.min(dObj.exp, dObj.act_sep);
            prevAct += Math.min(dObj.exp, dObj.act_sep);
          }
        }
      });
      const rate = exp > 0 ? (act / exp) * 100 : 0;
      const prevRate = exp > 0 ? (prevAct / exp) * 100 : 0;
      const momDiff = act - prevAct;
      const momPct = prevAct > 0 ? ((act - prevAct) / prevAct) * 100 : 0;
      return { dept: deptName, forms, exp, act, prevAct, rate, prevRate, momDiff, momPct };
    }

