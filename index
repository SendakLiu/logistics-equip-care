      document.getElementById('dailyKmValueLabel').textContent = '依點檢稼動率 (10~25 km/日)';
      renderKpi3();
      renderMaintTable();
      renderSchedTable();
    }

    function renderKpi3() {
      const isStageMode = mileMode === 'stage';
      const list = getProcessedEquipment().sort((a, b) => {
        if (a.has_real_mile !== b.has_real_mile) return a.has_real_mile ? -1 : 1;
        return isStageMode ? a.stage_rem_days - b.stage_rem_days : a.active_rem_days - b.active_rem_days;
      });

      const validList = list.filter(x => x.has_real_mile);
      const urgentCount = validList.filter(x => isStageMode ? x.stage_rem_days <= 14 : x.active_rem_days <= 30).length;
      const avgDays = validList.length > 0
        ? Math.round(validList.reduce((s, x) => s + (isStageMode ? x.stage_rem_days : x.active_rem_days), 0) / validList.length)
        : 0;

      document.getElementById('kpi3UrgentCount').innerHTML = `${urgentCount} <small class="text-base font-bold text-slate-500">台</small>`;
      document.getElementById('kpi3AvgDays').textContent = avgDays;
      document.getElementById('kpi3TotalEquip').textContent = list.length;

      const subDesc = document.getElementById('kpi3SubDesc');
      if (isStageMode) {
        subDesc.innerHTML = `14 天內需執行階段保養設備數（平均剩餘 <strong class="text-slate-700 dark:text-slate-200">${avgDays}</strong> 天 / 監控 <strong class="text-slate-700 dark:text-slate-200">${list.length}</strong> 台）`;
      } else {
        subDesc.innerHTML = `30 天內需執行 5,000km 大保設備數（平均剩餘 <strong class="text-slate-700 dark:text-slate-200">${avgDays}</strong> 天 / 監控 <strong class="text-slate-700 dark:text-slate-200">${list.length}</strong> 台）`;
      }

      const container = document.getElementById('kpi3MaintList');
      if (list.length === 0) {
        container.innerHTML = `<div class="py-10 text-center text-xs text-slate-400">目前篩選條件下無設備資料</div>`;
        return;
      }

      container.innerHTML = list.slice(0, 30).map(eq => {
        const remDays = isStageMode ? eq.stage_rem_days : eq.active_rem_days;
        const remKm = isStageMode ? eq.active_nearest_stage.rem_km : eq.active_rem_km;
        const targetKm = isStageMode ? eq.active_nearest_stage.next_km : eq.active_next_target_km;
        const cycleBase = isStageMode ? eq.active_nearest_stage.interval_km : 5000;
        const stageLabel = isStageMode ? eq.active_nearest_stage.label : eq.milestone_5000_label;
        const stageSummary = isStageMode ? eq.active_nearest_stage.summary : eq.milestone_5000_summary;

        const isUrgent = remDays <= (isStageMode ? 14 : 30);
        const isWarn = remDays <= (isStageMode ? 30 : 60);
        const badgeCls = isUrgent
          ? 'bg-rose-50 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800'
          : (isWarn ? 'bg-amber-50 text-amber-700 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200 dark:border-amber-800' : 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/80 dark:text-indigo-300');
        const pct = Math.min(100, Math.round(((cycleBase - remKm) / cycleBase) * 100));
        const barColor = isUrgent ? 'bg-rose-500' : (isWarn ? 'bg-amber-500' : 'bg-indigo-500');

        return `
          <div onclick="openEquipModal('${eq.dept}', '${eq.code}', '${eq.car}')" class="py-2.5 px-2 -mx-2 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700/40 cursor-pointer transition flex items-center justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">${eq.dept}</span>
                <span class="font-bold text-xs text-slate-900 dark:text-white">${eq.code} #${eq.car}</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/80 dark:text-indigo-300 truncate max-w-[180px]">${stageLabel}</span>
              </div>
              <div class="flex items-center gap-2.5 text-[11px] text-slate-500 dark:text-slate-400 mt-1 flex-wrap">
                <span>目前：<strong class="font-mono text-slate-700 dark:text-slate-200">${eq.active_curr_mile.toLocaleString()}</strong> km (<strong class="font-mono">${eq.est_hours.toLocaleString()}</strong> hr)</span>
                <span>距 ${targetKm.toLocaleString()}km 差 <strong class="font-mono text-indigo-600 dark:text-indigo-400">${remKm.toLocaleString()}</strong> km</span>
              </div>
              <div class="text-[11px] text-slate-400 dark:text-slate-500 truncate mt-0.5" title="${stageSummary}">保養項目：${stageSummary}</div>
              <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden mt-1.5">
                <div class="h-full ${barColor} rounded-full" style="width: ${pct}%"></div>
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="px-2.5 py-1 rounded-xl font-mono font-extrabold text-xs ${badgeCls}">
                剩餘 ${remDays} 天
              </div>
              <div class="text-[10px] text-slate-400 mt-0.5">日均 ${eq.active_daily_km} km (${eq.active_daily_hrs}h)</div>
            </div>
          </div>
        `;
      }).join('');
    }

